<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List of all Product</title>
</head>
<body>
    <h3>All product</h3>
    <form method="GET" action="/listings/new"><button>Add new product</button></form>
    <ul>
        <br><br>
        <% for(let list of listings){ %>
        <a href="/listings/<%= list._id %>">
                <%= list.name %><br><br>
        <% }%>
</ul>
</body>
</html>

