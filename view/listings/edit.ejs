<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your product details</title>
</head>
<body>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">
        <input type="text" value="<%= listing.name %>" name="listing[name]"></input>
        <br><br>
         <input type="number" value="<%= listing.price %>" name="listing[price]"></input>
         <br><br>
         <input type="text" value="<%= listing.image %>" name="listing[image]"></input>
         <br><br>
         <button>Edit</button>
    </form>
   
</body>
</html>